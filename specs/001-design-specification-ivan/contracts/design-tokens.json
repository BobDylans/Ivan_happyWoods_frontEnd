      "lg": { "value": "16px", "type": "fontSize" },
      "xl": { "value": "18px", "type": "fontSize" },
      "2xl": { "value": "24px", "type": "fontSize" },
      "3xl": { "value": "28px", "type": "fontSize" },
      "4xl": { "value": "32px", "type": "fontSize" }
    },
    
