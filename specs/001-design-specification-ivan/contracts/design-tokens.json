      },
      "text": {
        "primary": { "value": "{primitive.colors.neutral.900}", "type": "color" },
        "secondary": { "value": "{primitive.colors.neutral.600}", "type": "color" },
        "muted": { "value": "{primitive.colors.neutral.400}", "type": "color" },
        "inverse": { "value": "{primitive.colors.neutral.0}", "type": "color" }
      },
      "interactive": {
        "primary": { "value": "{primitive.colors.amber.500}", "type": "color" },
        "primaryHover": { "value": "{primitive.colors.amber.400}", "type": "color" },
        "secondary": { "value": "{primitive.colors.sage.500}", "type": "color" }
      },
      "border": {
        "default": { "value": "{primitive.colors.neutral.200}", "type": "color" },
        "focus": { "value": "{primitive.colors.amber.500}", "type": "color" }
      },
      "status": {
        "error": { "value": "{primitive.colors.coral.400}", "type": "color" },
        "success": { "value": "{primitive.colors.green.500}", "type": "color" },
        "warning": { "value": "{primitive.colors.amber.500}", "type": "color" }
      }
    },
    
    "spacing": {
      "section": { "value": "{primitive.spacing.8}", "type": "spacing", "description": "32px - 主要区块间距" },
      "card": { "value": "{primitive.spacing.4}", "type": "spacing", "description": "16px - 卡片间距" },
      "input": { "value": "{primitive.spacing.3}", "type": "spacing", "description": "12px - 输入框内边距" }
    },
    
    "borderRadius": {
      "button": { "value": "{primitive.borderRadius.md}", "type": "borderRadius" },
      "input": { "value": "{primitive.borderRadius.lg}", "type": "borderRadius" },
      "card": { "value": "{primitive.borderRadius.xl}", "type": "borderRadius" }
    }
  },
  
  "component": {
    "button": {
      "primary": {
        "bg": { "value": "{semantic.colors.interactive.primary}", "type": "color" },
        "bgHover": { "value": "{semantic.colors.interactive.primaryHover}", "type": "color" },
        "text": { "value": "{semantic.colors.text.inverse}", "type": "color" },
        "borderRadius": { "value": "{semantic.borderRadius.button}", "type": "borderRadius" },
        "paddingX": { "value": "{primitive.spacing.4}", "type": "spacing" },
        "paddingY": { "value": "{primitive.spacing.2}", "type": "spacing" }
      },
      "secondary": {
        "bg": { "value": "transparent", "type": "color" },
        "bgHover": { "value": "{semantic.colors.surface.secondary}", "type": "color" },
        "text": { "value": "{semantic.colors.text.primary}", "type": "color" },
        "border": { "value": "1px solid {semantic.colors.border.default}", "type": "border" }
      }
    },
    
    "card": {
      "bg": { "value": "{semantic.colors.surface.elevated}", "type": "color" },
      "borderRadius": { "value": "{semantic.borderRadius.card}", "type": "borderRadius" },
      "padding": { "value": "{primitive.spacing.5}", "type": "spacing" },
      "shadow": { "value": "{primitive.boxShadow.card}", "type": "boxShadow" },
      "shadowHover": { "value": "{primitive.boxShadow.cardHover}", "type": "boxShadow" }
    },
    
    "input": {
      "bg": { "value": "{semantic.colors.surface.elevated}", "type": "color" },
      "border": { "value": "1px solid {semantic.colors.border.default}", "type": "border" },
      "borderFocus": { "value": "1px solid {semantic.colors.border.focus}", "type": "border" },
      "borderRadius": { "value": "{semantic.borderRadius.input}", "type": "borderRadius" },
      "padding": { "value": "{semantic.spacing.input}", "type": "spacing" },
      "placeholder": { "value": "{semantic.colors.text.muted}", "type": "color" }
    },
    
    "sidebar": {
      "width": { "value": "220px", "type": "sizing" },
      "bg": { "value": "{semantic.colors.surface.elevated}", "type": "color" },
      "shadow": { "value": "{primitive.boxShadow.header}", "type": "boxShadow" },
      "activeIndicator": { "value": "{semantic.colors.interactive.primary}", "type": "color" }
    },
    
    "header": {
      "height": { "value": "64px", "type": "sizing" },
      "bg": { "value": "{semantic.colors.surface.elevated}", "type": "color" },
      "bgOpacity": { "value": "0.8", "type": "opacity" },
      "shadow": { "value": "{primitive.boxShadow.header}", "type": "boxShadow" }
    }
  },
  
  "animation": {
    "duration": {
      "fast": { "value": "150ms", "type": "duration" },
      "normal": { "value": "250ms", "type": "duration" },
      "slow": { "value": "400ms", "type": "duration" }
    },
    "easing": {
      "easeOut": { "value": "cubic-bezier(0, 0, 0.2, 1)", "type": "cubicBezier" },
      "easeInOut": { "value": "cubic-bezier(0.4, 0, 0.2, 1)", "type": "cubicBezier" },
      "spring": { "value": "spring(300, 20)", "type": "other", "description": "Framer Motion spring" }
    }
  },
  
  "breakpoints": {
    "mobile": { "value": "640px", "type": "sizing" },
    "tablet": { "value": "1024px", "type": "sizing" },
    "desktop": { "value": "1025px", "type": "sizing" }
  }
}
