        "0": { "value": "#FFFFFF", "type": "color", "description": "纯白" },
        "50": { "value": "#FDFCF9", "type": "color", "description": "主背景 - 温暖的米白色" },
        "100": { "value": "#F8F5F1", "type": "color", "description": "次级背景 - 深一度的米色" },
        "200": { "value": "#E2E0DC", "type": "color", "description": "边框和分隔线" },
        "400": { "value": "#A0A0A0", "type": "color", "description": "占位符文本" },
        "600": { "value": "#6B6B6B", "type": "color", "description": "次级文本" },
        "900": { "value": "#2B2B2B", "type": "color", "description": "主要文本 - 深炭灰色" }
      },
      "amber": {
        "400": { "value": "#F1C27D", "type": "color", "description": "浅琥珀 - 悬停状态" },
        "500": { "value": "#E4B16B", "type": "color", "description": "主琥珀 - 品牌主色" }
      },
      "sage": {
